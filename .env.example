# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# .env git'ga yuklanmaydi.

# Yandex xaritasi: developer.tech.yandex.ru → "JavaScript API и HTTP Геокодер" kaliti.
# HTTP Referer cheklovi: uyservice.uz (ilova xaritani shu manzildan ochadi)
EXPO_PUBLIC_YANDEX_MAPS_KEY=
# Xarita: yandex (standart) yoki 2gis — 2GIS MapGL kaliti (platform.2gis.ru), ruxsat etilgan domen: uyservice.uz
EXPO_PUBLIC_MAP_PROVIDER=
EXPO_PUBLIC_2GIS_KEY=

# Supabase (supabase.com → loyiha → Project Settings → API). Ikkalasi bo'sh bo'lsa ilova soxta (demo) rejimda ishlaydi.
# URL: https://<PROJECT_REF>.supabase.co ; kalit: "anon public" (yoki "publishable") — ilovaga qo'yish xavfsiz.
# service_role / secret kalitni bu yerga HECH QACHON yozmang (u faqat serverda).
# Eskiz.uz login-paroli ham bu yerga emas — Supabase secrets'ga: supabase/README.md
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS (expo.dev) loyiha raqami — telefon ilovasiga push uchun (`npx eas init` chiqaradi). Bo'sh bo'lsa push o'chiq.
# APK yig'ishda bu qiymatlar .env'dan emas, expo.dev → Environment variables'dan olinadi (supabase/README.md, 14-bo'lim)
EAS_PROJECT_ID=
