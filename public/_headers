# Butun sayt: faqat HTTPS (HSTS), brauzer fayl turini taxmin qilmaydi, boshqa saytlarga to'liq manzil ketmaydi.
# X-Frame-Options bu yerda YO'Q — web.telegram.org Mini App'ni iframe ichida ochadi.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# Cloudflare (Workers static assets): nomida hash bor fayllar (JS, shriftlar, rasmlar) uzoq keshlanadi — sayt tez ochiladi
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Admin panel: qidiruv tizimlariga ko'rinmaydi, boshqa saytlar ichiga (iframe) joylab bo'lmaydi
/admin*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
# PWA: service worker har safar yangisi tekshiriladi
/sw.js
  Cache-Control: no-cache
